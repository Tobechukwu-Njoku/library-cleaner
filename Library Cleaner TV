#!/bin/bash
# ============================================================
#  Subtitle + Trickplay Renamer for Sonarr TV Show Folders
#  (Unraid UserScripts)
# ============================================================
#  TV layout assumed:
#    <ROOT>/<Show (Year) [tvdbid-XXX]>/Season NN/<episode files>
#
#  Unlike the movie script, each season folder contains MANY
#  video files (one per episode). Subtitles and trickplay folders
#  are paired with their specific episode by the SxxExx token in
#  the filename, NOT by "largest video".
#
#  For each season folder:
#    1. Build a map  SxxExx -> episode video file
#    2. For every subtitle (.srt/.sub/.ass/.ssa/.vtt/.idx/.sup):
#         - Extract its SxxExx token
#         - Peel its language/flag suffix (.en, .ar.hi, etc.)
#         - Rename to <episode_video_base><suffix>.<ext>
#    3. For every <name>.trickplay folder:
#         - Extract its SxxExx token
#         - Rename to <episode_video_full_name>.trickplay
#
#  Multi-episode files (Show - S01E01-E02 - Title.mkv) are keyed
#  by their FIRST SxxExx token; their subtitles/trickplay are
#  expected to share that token.
# ============================================================

# --------------------- CONFIGURATION ------------------------

ROOT_DIR="/mnt/user/Media-Large/TV Shows/[2160p, MN]"

# Leave DRY_RUN="true" for the first run. Inspect log, then flip.
DRY_RUN="true"

# Set to "false" to disable ALL logging (file + console). The
# script still runs and performs renames silently.
ENABLE_LOG="true"

# Log file - ignored when ENABLE_LOG="false".
LOG_FILE="/mnt/user/appdata/subtitle_renamer/rename_tv.log"

VIDEO_EXTS=(mkv mp4 avi m4v mov mpg mpeg wmv flv webm ts m2ts)
SUB_EXTS=(srt sub ass ssa vtt idx sup)
KNOWN_FLAGS=(hi sdh cc forced default foreign cc1 cc2)
MAX_SUFFIX_PARTS=3

# Strip a trailing ".hi" (hearing-impaired) ONLY when another
# language/flag component precedes it. A lone ".hi" is preserved
# because it might be the Hindi language code.
STRIP_HI="false"

# DESTRUCTIVE. When "true", subtitle files in a season folder
# whose SxxExx token has no matching episode video are DELETED.
# Subs without any SxxExx token are also deleted, since they
# can't be paired. Honors DRY_RUN — nothing is removed in
# dry-run mode. Leave "false" unless you've reviewed at least one
# dry-run log and trust the result.
DELETE_ORPHANS="false"

# DESTRUCTIVE. When "true", a subtitle whose rename target ALREADY
# EXISTS (currently logged as [SUB SKIP exists]) is DELETED instead
# of being left in place. The pre-existing file at the target path
# is kept untouched. Honors DRY_RUN.
DELETE_DUPLICATES="false"

# DESTRUCTIVE. When "true", subtitle files whose name is malformed
# in one of the patterns below are DELETED instead of being
# renamed. Honors DRY_RUN. Detects:
#   1. A numeric component just before the lang/flag suffix:
#        ...S01E01.3.hi.srt   ...S01E01.7.hi.srt
#      (typically junk left over from audio-track-ID parsing)
#   2. Duplicate components in the peeled suffix:
#        ...S01E01.hi.hi.srt   ...S01E01.en.en.srt
DELETE_OUTLIERS="false"

# DESTRUCTIVE. When "true", any .nfo file in a season folder whose
# basename does NOT match any episode video's basename (and isn't
# the alternate "season.nfo" convention) is DELETED. Honors
# DRY_RUN. Useful for clearing out stale .nfo files left behind
# from prior episode renames. (tvshow.nfo lives in the show root,
# not a season folder, so it's untouched by this script.)
DELETE_OUTLIER_NFO="false"

# Only descend into folders matching this regex. Sonarr always
# uses "Season NN" (and "Specials" for Season 00). Set to an
# empty string to scan every subfolder of every show.
SEASON_DIR_REGEX='^(Season[ _.-]?[0-9]+|Specials)$'

# --------------------- END CONFIGURATION --------------------

set -u

if [ "$ENABLE_LOG" = "true" ]; then
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
    log() { echo "$@" | tee -a "$LOG_FILE"; }
else
    log() { :; }
fi

log "=========================================================="
log " TV Subtitle + Trickplay Renamer: $(date '+%Y-%m-%d %H:%M:%S')"
log " Root:    $ROOT_DIR"
log " Dry-run: $DRY_RUN"
log "=========================================================="

if [ ! -d "$ROOT_DIR" ]; then
    log "ERROR: ROOT_DIR does not exist: $ROOT_DIR"
    exit 1
fi

# Build flag regex for is_suffix_component().
FLAG_RE=""
for f in "${KNOWN_FLAGS[@]}"; do FLAG_RE+="|$f"; done
FLAG_RE="${FLAG_RE:1}"

is_suffix_component() {
    local c="${1,,}"
    [[ "$c" =~ ^[a-z]{2,3}(-[a-z0-9]{2,4})?$ ]] && return 0
    [[ "$c" =~ ^($FLAG_RE)$ ]] && return 0
    return 1
}

# Extract the first SxxExx token from a name, uppercased.
# Returns empty string if no token is found.
extract_ep_token() {
    local name="$1"
    if [[ "$name" =~ [Ss]([0-9]{1,3})[Ee]([0-9]{1,4}) ]]; then
        printf 'S%sE%s' \
            "$(printf '%02d' "$((10#${BASH_REMATCH[1]}))")" \
            "$(printf '%02d' "$((10#${BASH_REMATCH[2]}))")"
    fi
}

# ---------- Discover season folders -------------------------
# A season folder is any directory whose name matches the regex
# AND whose parent is a show folder (i.e. directly under a show).
# We use find with -mindepth/-maxdepth to keep this fast.

mapfile -t season_folders < <(
    find "$ROOT_DIR" -mindepth 2 -maxdepth 2 -type d \
        | awk -v re="$SEASON_DIR_REGEX" \
              'BEGIN{IGNORECASE=0} { n=split($0,a,"/"); name=a[n];
                if (re=="" || name ~ re) print $0 }'
)

log " Season folders found: ${#season_folders[@]}"

# Counters
sub_rename=0; sub_skip_noop=0; sub_skip_exists=0; sub_skip_noep=0
tp_rename=0;  tp_skip_noop=0;  tp_skip_exists=0;  tp_skip_noep=0
ep_ambig=0;   error_count=0
orphan_delete=0
duplicate_delete=0
outlier_delete=0
nfo_outlier_delete=0

# Helper: delete an orphan subtitle (or dry-run log it).
delete_orphan_sub() {
    local sub="$1" reason="$2"
    if [ "$DRY_RUN" = "true" ]; then
        log "[ORPHAN DRY-RUN delete - $reason] $sub"
        orphan_delete=$((orphan_delete + 1))
    else
        if rm -- "$sub"; then
            log "[ORPHAN DELETED - $reason] $sub"
            orphan_delete=$((orphan_delete + 1))
        else
            log "[ORPHAN ERROR - $reason] $sub"
            error_count=$((error_count + 1))
        fi
    fi
}

# Helper: delete a malformed subtitle (or dry-run log it).
delete_outlier_sub() {
    local sub="$1" reason="$2"
    if [ "$DRY_RUN" = "true" ]; then
        log "[OUTLIER DRY-RUN delete - $reason] $sub"
        outlier_delete=$((outlier_delete + 1))
    else
        if rm -- "$sub"; then
            log "[OUTLIER DELETED - $reason] $sub"
            outlier_delete=$((outlier_delete + 1))
        else
            log "[OUTLIER ERROR - $reason] $sub"
            error_count=$((error_count + 1))
        fi
    fi
}

for season in "${season_folders[@]}"; do
    # Map: SxxExx -> path of episode video. Also count duplicates.
    declare -A EP_VIDEO=()
    declare -A EP_DUP=()

    shopt -s nullglob nocaseglob
    for ext in "${VIDEO_EXTS[@]}"; do
        for v in "$season"/*."$ext"; do
            [ -f "$v" ] || continue
            tok="$(extract_ep_token "$(basename "$v")")"
            [ -z "$tok" ] && continue
            if [ -n "${EP_VIDEO[$tok]:-}" ]; then
                EP_DUP["$tok"]=1
                log "[EP DUPLICATE] $tok in $season"
            else
                EP_VIDEO["$tok"]="$v"
            fi
        done
    done
    shopt -u nullglob nocaseglob

    # ---------- SUBTITLES in this season folder -------------
    shopt -s nullglob nocaseglob
    subs=()
    for ext in "${SUB_EXTS[@]}"; do
        for s in "$season"/*."$ext"; do subs+=("$s"); done
    done
    shopt -u nullglob nocaseglob

    for sub in "${subs[@]}"; do
        sub_basename="$(basename "$sub")"
        sub_ext="${sub_basename##*.}"
        name_no_ext="${sub_basename%.*}"

        tok="$(extract_ep_token "$sub_basename")"
        if [ -z "$tok" ]; then
            if [ "$DELETE_ORPHANS" = "true" ]; then
                delete_orphan_sub "$sub" "no SxxExx"
            else
                log "[SUB SKIP no SxxExx] $sub"
                sub_skip_noep=$((sub_skip_noep + 1))
            fi
            continue
        fi
        if [ -n "${EP_DUP[$tok]:-}" ]; then
            log "[SUB SKIP duplicate ep $tok] $sub"
            ep_ambig=$((ep_ambig + 1))
            continue
        fi
        ep_video="${EP_VIDEO[$tok]:-}"
        if [ -z "$ep_video" ]; then
            if [ "$DELETE_ORPHANS" = "true" ]; then
                delete_orphan_sub "$sub" "no video for $tok"
            else
                log "[SUB SKIP no video for $tok] $sub"
                sub_skip_noep=$((sub_skip_noep + 1))
            fi
            continue
        fi

        ep_basename="$(basename "$ep_video")"
        ep_name="${ep_basename%.*}"

        # Peel trailing language / flag components.
        components=()
        remainder="$name_no_ext"
        for ((i = 0; i < MAX_SUFFIX_PARTS; i++)); do
            [[ "$remainder" == *.* ]] || break
            last="${remainder##*.}"
            if is_suffix_component "$last"; then
                components=("${last,,}" "${components[@]}")
                remainder="${remainder%.*}"
            else
                break
            fi
        done

        # ---- Outlier detection -----------------------------
        # 1. Remainder ends in a digit-only token (e.g. .3.hi.srt
        #    where the .3 is junk from old audio-track parsing).
        # 2. Peeled components contain a duplicate (e.g. .hi.hi).
        outlier_reason=""
        if [[ "$remainder" == *.* ]]; then
            trailing="${remainder##*.}"
            if [[ "$trailing" =~ ^[0-9]+$ ]]; then
                outlier_reason="trailing numeric '.$trailing'"
            fi
        fi
        if [ -z "$outlier_reason" ] && [ ${#components[@]} -ge 2 ]; then
            declare -A seen_comp=()
            for c in "${components[@]}"; do
                if [ -n "${seen_comp[$c]:-}" ]; then
                    outlier_reason="duplicate suffix '.$c'"
                    break
                fi
                seen_comp["$c"]=1
            done
            unset seen_comp
        fi

        if [ -n "$outlier_reason" ]; then
            if [ "$DELETE_OUTLIERS" = "true" ]; then
                delete_outlier_sub "$sub" "$outlier_reason"
                continue
            else
                log "[SUB OUTLIER ($outlier_reason)] $sub"
            fi
        fi
        # ----------------------------------------------------

        # STRIP_HI: drop trailing ".hi" only when not the lone token.
        if [ "$STRIP_HI" = "true" ] \
           && [ ${#components[@]} -gt 1 ] \
           && [ "${components[-1]}" = "hi" ]; then
            unset 'components[-1]'
        fi

        suffix=""
        for c in "${components[@]}"; do suffix+=".$c"; done

        new_name="${ep_name}${suffix}.${sub_ext,,}"
        new_path="$season/$new_name"

        if [ "$sub_basename" = "$new_name" ]; then
            sub_skip_noop=$((sub_skip_noop + 1))
            continue
        fi
        if [ -e "$new_path" ]; then
            if [ "$DELETE_DUPLICATES" = "true" ]; then
                if [ "$DRY_RUN" = "true" ]; then
                    log "[SUB DUP DRY-RUN delete] $sub"
                    log "                target:  $new_path"
                    duplicate_delete=$((duplicate_delete + 1))
                else
                    if rm -- "$sub"; then
                        log "[SUB DUP DELETED] $sub"
                        duplicate_delete=$((duplicate_delete + 1))
                    else
                        log "[SUB DUP ERROR] Failed to delete: $sub"
                        error_count=$((error_count + 1))
                    fi
                fi
            else
                log "[SUB SKIP exists] $sub"
                log "             -->  $new_path"
                sub_skip_exists=$((sub_skip_exists + 1))
            fi
            continue
        fi

        if [ "$DRY_RUN" = "true" ]; then
            log "[SUB DRY-RUN] $sub"
            log "         -->  $new_path"
            sub_rename=$((sub_rename + 1))
        else
            if mv -n -- "$sub" "$new_path"; then
                log "[SUB RENAMED] $sub_basename"
                log "         -->  $new_name"
                sub_rename=$((sub_rename + 1))
            else
                log "[SUB ERROR] Failed to rename: $sub"
                error_count=$((error_count + 1))
            fi
        fi
    done

    # ---------- TRICKPLAY folders in this season folder -----
    shopt -s nullglob
    trickplays=("$season"/*.trickplay)
    shopt -u nullglob

    for tp in "${trickplays[@]}"; do
        [ -d "$tp" ] || continue
        tp_basename="$(basename "$tp")"

        tok="$(extract_ep_token "$tp_basename")"
        if [ -z "$tok" ]; then
            log "[TP SKIP no SxxExx] $tp"
            tp_skip_noep=$((tp_skip_noep + 1))
            continue
        fi
        if [ -n "${EP_DUP[$tok]:-}" ]; then
            log "[TP SKIP duplicate ep $tok] $tp"
            ep_ambig=$((ep_ambig + 1))
            continue
        fi
        ep_video="${EP_VIDEO[$tok]:-}"
        if [ -z "$ep_video" ]; then
            log "[TP SKIP no video for $tok] $tp"
            tp_skip_noep=$((tp_skip_noep + 1))
            continue
        fi

        ep_basename="$(basename "$ep_video")"      # episode.mkv
        ep_name_noext="${ep_basename%.*}"           # episode
        expected_tp="${ep_name_noext}.trickplay"
        target_path="$season/$expected_tp"

        if [ "$tp_basename" = "$expected_tp" ]; then
            tp_skip_noop=$((tp_skip_noop + 1))
            continue
        fi

        # If this trickplay still matches a different existing
        # video in the same folder (e.g. an extra/featurette video
        # with its own paired trickplay), leave it alone.
        linked_base="${tp_basename%.trickplay}"
        linked_paired=0
        shopt -s nullglob nocaseglob
        for vext in "${VIDEO_EXTS[@]}"; do
            if [ -e "$season/${linked_base}.$vext" ]; then
                linked_paired=1
                break
            fi
        done
        shopt -u nullglob nocaseglob
        if [ $linked_paired -eq 1 ]; then
            tp_skip_noop=$((tp_skip_noop + 1))
            continue
        fi

        if [ -e "$target_path" ]; then
            log "[TP SKIP exists] $tp"
            log "            -->  $target_path"
            tp_skip_exists=$((tp_skip_exists + 1))
            continue
        fi

        if [ "$DRY_RUN" = "true" ]; then
            log "[TP DRY-RUN] $tp"
            log "        -->  $target_path"
            tp_rename=$((tp_rename + 1))
        else
            if mv -n -- "$tp" "$target_path"; then
                log "[TP RENAMED] $tp_basename"
                log "        -->  $expected_tp"
                tp_rename=$((tp_rename + 1))
            else
                log "[TP ERROR] Failed to rename: $tp"
                error_count=$((error_count + 1))
            fi
        fi
    done

    # ------------------ OUTLIER .NFO ------------------------
    # Build the set of valid .nfo names: <episode_video_base>.nfo
    # for every episode in this season folder, plus the alternate
    # "season.nfo" convention. Anything else is a stale leftover.
    if [ "$DELETE_OUTLIER_NFO" = "true" ]; then
        declare -A valid_nfo=( ["season.nfo"]=1 )
        shopt -s nullglob nocaseglob
        for ext in "${VIDEO_EXTS[@]}"; do
            for v in "$season"/*."$ext"; do
                [ -f "$v" ] || continue
                vbase="$(basename "$v")"
                key="${vbase%.*}.nfo"
                valid_nfo["${key,,}"]=1
            done
        done

        for nfo in "$season"/*.nfo; do
            [ -f "$nfo" ] || continue
            nfo_name="$(basename "$nfo")"
            if [ -n "${valid_nfo[${nfo_name,,}]:-}" ]; then
                continue
            fi

            if [ "$DRY_RUN" = "true" ]; then
                log "[NFO OUTLIER DRY-RUN delete] $nfo"
                nfo_outlier_delete=$((nfo_outlier_delete + 1))
            else
                if rm -- "$nfo"; then
                    log "[NFO OUTLIER DELETED] $nfo"
                    nfo_outlier_delete=$((nfo_outlier_delete + 1))
                else
                    log "[NFO OUTLIER ERROR] $nfo"
                    error_count=$((error_count + 1))
                fi
            fi
        done
        shopt -u nullglob nocaseglob
        unset valid_nfo
    fi

    unset EP_VIDEO EP_DUP
done

log "=========================================================="
log " Finished: $(date '+%Y-%m-%d %H:%M:%S')"
log " Season folders processed:       ${#season_folders[@]}"
if [ "$DRY_RUN" = "true" ]; then
    log " Subtitles would rename:         $sub_rename"
    log " Trickplay would rename:         $tp_rename"
else
    log " Subtitles renamed:              $sub_rename"
    log " Trickplay folders renamed:      $tp_rename"
fi
log " Subtitles already correct:      $sub_skip_noop"
log " Subtitles skipped (exists):     $sub_skip_exists"
log " Subtitles skipped (no episode): $sub_skip_noep"
log " Trickplay already correct:      $tp_skip_noop"
log " Trickplay skipped (exists):     $tp_skip_exists"
log " Trickplay skipped (no episode): $tp_skip_noep"
log " Skipped (ambiguous duplicate):  $ep_ambig"
if [ "$DELETE_ORPHANS" = "true" ]; then
    if [ "$DRY_RUN" = "true" ]; then
        log " Orphan subs would delete:       $orphan_delete"
    else
        log " Orphan subs deleted:            $orphan_delete"
    fi
fi
if [ "$DELETE_DUPLICATES" = "true" ]; then
    if [ "$DRY_RUN" = "true" ]; then
        log " Duplicate subs would delete:    $duplicate_delete"
    else
        log " Duplicate subs deleted:         $duplicate_delete"
    fi
fi
if [ "$DELETE_OUTLIERS" = "true" ]; then
    if [ "$DRY_RUN" = "true" ]; then
        log " Outlier subs would delete:      $outlier_delete"
    else
        log " Outlier subs deleted:           $outlier_delete"
    fi
fi
if [ "$DELETE_OUTLIER_NFO" = "true" ]; then
    if [ "$DRY_RUN" = "true" ]; then
        log " Outlier .nfo would delete:      $nfo_outlier_delete"
    else
        log " Outlier .nfo deleted:           $nfo_outlier_delete"
    fi
fi
log " Errors:                         $error_count"
log "=========================================================="
